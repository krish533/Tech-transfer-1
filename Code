def print_table(df, title, floatfmt=".4f"):
    """Pretty-print a DataFrame to console with a title box."""
    log(f"\n{'─'*70}")
    log(f"  TABLE: {title}")
    log(f"{'─'*70}")
    if HAS_TABULATE:
        log(tabulate(df, headers="keys", tablefmt="psql",
                     showindex=False, floatfmt=floatfmt))
    else:
        log(df.to_string(index=False))
    log("")


def save_table(df, stem, title=None, notes=None, floatfmt=".4f",
               index=False, latex_header=None):
    """
    Save a table as:
        tables/<stem>.csv       – machine-readable
        tables/<stem>.tex       – LaTeX fragment (booktabs longtable)
    Also prints to console.
    """
    # 1. Console
    print_table(df, title or stem, floatfmt=floatfmt)

    # 2. CSV
    df.to_csv(TAB_DIR / f"{stem}.csv", index=index)

    # 3. LaTeX fragment
    col_fmt = "l" + "r" * (len(df.columns) - 1)
    lines = [
        r"\begin{table}[H]",
        r"\centering",
        f"\\caption{{{title or stem}}}",
        f"\\label{{tab:{stem}}}",
        r"\begin{threeparttable}",
        r"\small",
        f"\\begin{{tabular}}{{{col_fmt}}}",
        r"\toprule",
    ]
    # header
    hdr = " & ".join(f"\\textbf{{{c}}}" for c in df.columns) + r" \\"
    lines.append(hdr)
    lines.append(r"\midrule")
    # rows
    for _, row in df.iterrows():
        cells = []
        for v in row:
            if isinstance(v, float):
                cells.append(f"{v:{floatfmt}}")
            else:
                cells.append(str(v).replace("&","\\&").replace("%","\\%"))
        lines.append(" & ".join(cells) + r" \\")
    lines.append(r"\bottomrule")
    lines.append(r"\end{tabular}")
    if notes:
        lines += [
            r"\begin{tablenotes}\small",
            f"\\item \\textit{{Notes:}} {notes}",
            r"\end{tablenotes}",
        ]
    lines += [r"\end{threeparttable}", r"\end{table}"]
    (TAB_DIR / f"{stem}.tex").write_text("\n".join(lines))

    log(f"  ✓ Saved: tables/{stem}.csv  +  tables/{stem}.tex")


