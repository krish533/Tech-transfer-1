iwork    = inst.dropna(subset=["pci"]).copy()
pci_vals = iwork["pci"].values
mask_pr1 = (iwork["inst_type"]=="Private R1").values
mask_pu1 = (iwork["inst_type"]=="Public R1").values
mask_med = (iwork["medschool"]==1).values
mask_nom = (iwork["medschool"]==0).values

perm_type = np.empty(1000); perm_med  = np.empty(1000)
for i in range(1000):
    p = np.random.permutation(pci_vals)
    perm_type[i] = p[mask_pr1].mean() - p[mask_pu1].mean()
    perm_med[i]  = p[mask_med].mean() - p[mask_nom].mean()

p_perm_type = (np.abs(perm_type) >= np.abs(obs_type)).mean()
p_perm_med  = (np.abs(perm_med)  >= np.abs(obs_med)).mean()

log(f"  Observed Private R1 vs Public R1 gap : {obs_type:.4f}")
log(f"  Permutation p-value (inst type)      : {p_perm_type:.4f}")
log(f"  Observed med school gap              : {obs_med:.4f}")
log(f"  Permutation p-value (med school)     : {p_perm_med:.4f}")

t_perm = pd.DataFrame({
    "Comparison":    ["Private R1 vs. Public R1", "Med School vs. No Med School"],
    "Observed Gap":  [round(obs_type,4), round(obs_med,4)],
    "Perm. p-value": [round(p_perm_type,4), round(p_perm_med,4)],
    "N Permutations":[1000, 1000],
})
save_table(t_perm, "tableE1_permutation",
           title="Placebo Permutation Tests for Cross-Sectional Gaps",
           notes="1,000 random label permutations. Two-sided p-value reported.",
           floatfmt=".4f")


