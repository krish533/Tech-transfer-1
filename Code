sig_kw = "***" if kw_p < 0.01 else "**" if kw_p < 0.05 else "*" if kw_p < 0.10 else ""

for t, g in zip(TYPE_ORDER, type_grps):
    rows.append({
        "Group": f"  {t}",
        "N": int(len(g)),
        "Mean": round(g.mean(), 3),
        "SD":   round(g.std(),  3),
        "Min":  round(g.min(),  3),
        "Max":  round(g.max(),  3),
        "Test": "K-W" if t == TYPE_ORDER[0] else "",
        "p-value": f"{kw_p:.3f}{sig_kw}" if t == TYPE_ORDER[0] else "",
    })

rows.append({k: "" for k in rows[0]})
rows[-1]["Group"] = "── Urbanicity ──"

# ── urbanicity ────────────────────────────────────────────────────────────────
urb_grps = [inst.loc[inst["urbanicity"]==u,"pci"].dropna() for u in URB_ORDER
            if u in inst["urbanicity"].values]
urb_names= [u for u in URB_ORDER if u in inst["urbanicity"].values]
kw_u, p_u = kruskal(*[g.values for g in urb_grps]) if len(urb_grps)>1 else (np.nan, np.nan)
sig_u = "†" if p_u < 0.10 else ""

for i,(u, g) in enumerate(zip(urb_names, urb_grps)):
    rows.append({
        "Group": f"  {u}",
        "N": int(len(g)),
