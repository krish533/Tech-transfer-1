# 10.  TABLE 9 — VARIANCE DECOMPOSITION
# ══════════════════════════════════════════════════════════════════════════════
banner("10. TABLE 9 — VARIANCE DECOMPOSITION")

comp = pol[["pci","Tone_Index","Clarity_Index","Legal_Load_Index"]].dropna().copy()
log(f"  Regression sample N = {len(comp):,}")

m1 = smf.ols("pci ~ Tone_Index", data=comp).fit(cov_type="HC3")
m2 = smf.ols("pci ~ Tone_Index + Clarity_Index", data=comp).fit(cov_type="HC3")
m3 = smf.ols("pci ~ Tone_Index + Clarity_Index + Legal_Load_Index",
             data=comp).fit(cov_type="HC3")

def stars(p):
    return "***" if p<0.01 else "**" if p<0.05 else "*" if p<0.10 else ""

def coef_str(mod, var):
    if var not in mod.params:
        return "—", ""
    c, s, p = mod.params[var], mod.bse[var], mod.pvalues[var]
    return f"{c:.4f}{stars(p)}", f"({s:.4f})"

sub("Model summaries")
log(f"  Model 1 R²      : {m1.rsquared:.4f}")
log(f"  Model 2 R²      : {m2.rsquared:.4f}  ΔR²={m2.rsquared-m1.rsquared:.4f}")
log(f"  Model 3 R²      : {m3.rsquared:.4f}  ΔR²={m3.rsquared-m2.rsquared:.4f}")

# Build display table
t9_rows = []
for var, label in [("Tone_Index","Tone Index"),
                   ("Clarity_Index","Clarity Index"),
                   ("Legal_Load_Index","Legal Load Index"),
                   ("Intercept","Intercept")]:
    c1,s1 = coef_str(m1, var)
    c2,s2 = coef_str(m2, var)
    c3,s3 = coef_str(m3, var)
    t9_rows.append({"Variable": label, "M1 coef": c1, "M1 SE": s1,
                    "M2 coef": c2, "M2 SE": s2, "M3 coef": c3, "M3 SE": s3})

# add R² rows
t9_rows.append({"Variable":"R²",
                "M1 coef":f"{m1.rsquared:.4f}", "M1 SE":"",
                "M2 coef":f"{m2.rsquared:.4f}", "M2 SE":"",
                "M3 coef":f"{m3.rsquared:.4f}", "M3 SE":""})
t9_rows.append({"Variable":"ΔR²",
                "M1 coef":"—", "M1 SE":"",
                "M2 coef":f"{m2.rsquared-m1.rsquared:.4f}", "M2 SE":"",
                "M3 coef":f"{m3.rsquared-m2.rsquared:.4f}", "M3 SE":""})
t9_rows.append({"Variable":"N",
                "M1 coef":str(int(m1.nobs)), "M1 SE":"",
                "M2 coef":str(int(m2.nobs)), "M2 SE":"",
                "M3 coef":str(int(m3.nobs)), "M3 SE":""})

t9 = pd.DataFrame(t9_rows)
save_table(t9, "table9_decomposition",
           title="Variance Decomposition of the Policy Communication Index",
           notes=("Dep. var = policy-level PCI. HC3-robust SE in parentheses. "
                  "*** p<0.01, ** p<0.05, * p<0.10."),
           floatfmt=".4f")

# Full coefficient printout on console
sub("Full regression results")
for mod, name in [(m1,"M1 Tone only"),(m2,"M2 +Clarity"),(m3,"M3 +Legal")]:
    log(f"\n  [{name}]  R²={mod.rsquared:.4f}  N={int(mod.nobs)}")
    log(f"  {'Variable':<25} {'Coef':>10} {'SE':>10} {'t':>8} {'p':>8}")
    for vn in mod.params.index:
        c,s,t,p = mod.params[vn], mod.bse[vn], mod.tvalues[vn], mod.pvalues[vn]
        log(f"  {vn:<25} {c:>10.4f} {s:>10.4f} {t:>8.3f} {p:>8.4f} {stars(p)}")


